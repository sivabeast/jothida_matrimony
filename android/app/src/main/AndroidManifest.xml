<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Firebase / network access (required in release builds). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- FCM notifications on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- "Use My Location" — GPS-based city/state/country detection. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Google Play Billing (in-app purchases — the horoscope_report product).
         The in_app_purchase_android plugin also merges this permission, but it
         is declared explicitly here for clarity. -->
    <uses-permission android:name="com.android.vending.BILLING"/>
    <!-- Saving a downloaded profile form into Downloads / Pictures.
         Only needed up to API 28: from API 29 the app writes through
         MediaStore, which grants access to the rows it inserts and needs no
         permission at all. See MainActivity.kt. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>
    <application
        android:label="Jothida Matrimony"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- singleTop keeps a relaunch (launcher tap, notification tap, deep
             link) on the SAME activity instance instead of stacking a second
             copy, and delivers it through onNewIntent.

             taskAffinity is deliberately NOT set. It used to be "" here, which
             is what put duplicate cards in Android Recents: an empty affinity
             puts the activity in no task family at all, so every launch
             carrying FLAG_ACTIVITY_NEW_TASK - which is exactly what the
             launcher and notification intents use - failed to match the running
             task and started a fresh one. Left unset it defaults to the package
             name, every launch resolves to the one task, and Recents shows a
             single card. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- FCM: post background/killed-state pushes on the app's own
             high-importance channel (created by FcmService at startup via
             flutter_local_notifications) instead of the low-importance FCM
             fallback channel. Keep in sync with FcmService and
             functions/index.js (channelId). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="high_importance_channel" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Package visibility for url_launcher on Android 11+. Without these
             the https / dialer / mail lookups resolve to nothing, and actions
             such as the Google Maps Directions button silently no-op. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
    </queries>
</manifest>
